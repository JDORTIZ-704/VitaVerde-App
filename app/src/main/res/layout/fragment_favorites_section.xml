<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FavoritesSection">

    <HorizontalScrollView
        android:id="@+id/homePromoScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="153dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_scroll_rounded"
    android:clipToOutline="true"
    android:outlineProvider="background"
    android:fillViewport="true"
    android:scrollbars="none"
    android:overScrollMode="never"
    android:padding="8dp"
    android:importantForAccessibility="no"
    android:contentDescription="@null"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/homePromo1"
            android:layout_width="280dp"
            android:layout_height="140dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_scroll_rounded"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:src="@drawable/home_promo_1"
        android:contentDescription="@null"
        android:importantForAccessibility="no"/>

        <ImageView
            android:id="@+id/homePromo2"
            android:layout_width="280dp"
            android:layout_height="140dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_scroll_rounded"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/home_promo_2"
            android:contentDescription="@null"
            android:importantForAccessibility="no"/>

        <ImageView
            android:id="@+id/homePromo3"
            android:layout_width="280dp"
            android:layout_height="140dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_scroll_rounded"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/home_promo_3"
            android:contentDescription="@null"
            android:importantForAccessibility="no"/>

    </LinearLayout>
</HorizontalScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
