<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_general"
    tools:context=".FavoritesSection">

    <HorizontalScrollView
        android:id="@+id/homePromoScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="153dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_scroll_rounded"
        android:clipToOutline="true"
        android:outlineProvider="background"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:padding="8dp"
        android:importantForAccessibility="no"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/homePromo1"
            android:layout_width="280dp"
            android:layout_height="140dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_scroll_rounded"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/home_promo_1"
            android:contentDescription="@null"
            android:importantForAccessibility="no"/>

        <ImageView
            android:id="@+id/homePromo2"
            android:layout_width="280dp"
            android:layout_height="140dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_scroll_rounded"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/home_promo_2"
            android:contentDescription="@null"
            android:importantForAccessibility="no"/>

        <ImageView
            android:id="@+id/homePromo3"
            android:layout_width="280dp"
            android:layout_height="140dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_scroll_rounded"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/home_promo_3"
            android:contentDescription="@null"
            android:importantForAccessibility="no"/>

    </LinearLayout>

</HorizontalScrollView>

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="77dp"
        android:layout_height="65dp"
        android:src="@drawable/logo_avocado_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.019" />

    <TextView
        android:id="@+id/textView10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/yeon_sung"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:text="@string/txt_Informative_Favorite_Section_1"
        app:layout_constraintBottom_toTopOf="@+id/homePromoScroll"
        app:layout_constraintEnd_toEndOf="@+id/imageView"
        app:layout_constraintStart_toStartOf="@+id/imageView"
        app:layout_constraintTop_toBottomOf="@+id/imageView" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="24dp"
        android:layout_height="28.75dp"
        android:src="@drawable/icon_campaign"
        app:layout_constraintBottom_toTopOf="@+id/textView10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.825"
        app:layout_constraintStart_toEndOf="@+id/imageView"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.546" />

    <TextView
        android:id="@+id/textView11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/yeon_sung"
        android:gravity="center"
        android:text="@string/txt_Informative_Favorite_Section_2"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.113"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/homePromoScroll"
        app:layout_constraintVertical_bias="0.057" />

    <Button
        android:id="@+id/button"
        style="@style/Widget.Vermas.SimpleButton"
        android:layout_width="116dp"
        android:layout_height="36dp"
        android:text="@string/btn_FavoriteSection_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.754"
        app:layout_constraintStart_toEndOf="@+id/textView11"
        app:layout_constraintTop_toBottomOf="@+id/homePromoScroll"
        app:layout_constraintVertical_bias="0.04" />

</androidx.constraintlayout.widget.ConstraintLayout>
