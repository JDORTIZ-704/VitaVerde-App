<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_general"
    tools:context=".FavoritesSection">

    <!-- SCROLL PROMOS -->
    <HorizontalScrollView
        android:id="@+id/homePromoScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="153dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_scroll_rounded"
        android:clipToOutline="true"
        android:outlineProvider="background"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:padding="8dp"
        android:importantForAccessibility="no"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/homePromo1"
                android:layout_width="280dp"
                android:layout_height="140dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_scroll_rounded"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/home_promo_1" />

            <ImageView
                android:id="@+id/homePromo2"
                android:layout_width="280dp"
                android:layout_height="140dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_scroll_rounded"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/home_promo_2" />

            <ImageView
                android:id="@+id/homePromo3"
                android:layout_width="280dp"
                android:layout_height="140dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_scroll_rounded"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/home_promo_3" />

        </LinearLayout>

    </HorizontalScrollView>


    <!-- LOGO -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="77dp"
        android:layout_height="65dp"
        android:src="@drawable/logo_avocado_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.019" />


    <!-- TEXTO 1 -->
    <TextView
        android:id="@+id/textView10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/yeon_sung"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:text="@string/txt_Informative_Favorite_Section_1"
        app:layout_constraintBottom_toTopOf="@+id/homePromoScroll"
        app:layout_constraintEnd_toEndOf="@+id/imageView"
        app:layout_constraintStart_toStartOf="@+id/imageView"
        app:layout_constraintTop_toBottomOf="@+id/imageView" />


    <!-- ICONO CAMPAÑA -->
    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="24dp"
        android:layout_height="28.75dp"
        android:src="@drawable/icon_campaign"
        app:layout_constraintBottom_toTopOf="@+id/textView10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageView"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- TEXTO 2 -->


    <!-- BOTÓN -->
    <TextView
        android:id="@+id/textView11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/yeon_sung"
        android:gravity="center"
        android:text="@string/txt_Informative_Favorite_Section_2"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.065"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/homePromoScroll" />

    <Button
        android:id="@+id/button"
        style="@style/Widget.Vermas.SimpleButton"
        android:layout_width="116dp"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:text="@string/btn_FavoriteSection_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/homePromoScroll" />


    <!-- CARDVIEW (ya con su contenido correcto adentro) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/productCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@+id/textView11"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/linearLayout"
            style="@style/Widget.cardview.general"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:id="@+id/imgProduct"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:padding="5dp"
                android:scaleType="centerCrop"
                android:src="@drawable/img_mandarina" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">

                <TextView
                    android:id="@+id/txtName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/yeon_sung"
                    android:text="Mandarina"
                    android:textColor="#000"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$3.500 COP"
                    android:textColor="#1BB200"
                    android:textSize="16sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnAdd"
                style="@style/Widget.VitaVerde.GradientButton.CardView"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="@string/btn_add_cardview" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <!-- CARDVIEW (ya con su contenido correcto adentro) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/productCard2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@+id/productCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/linearLayout2"
            style="@style/Widget.cardview.general"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:id="@+id/imgProduct2"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:padding="5dp"
                android:scaleType="centerCrop"
                android:src="@drawable/img_mandarina" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">

                <TextView
                    android:id="@+id/txtName2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/yeon_sung"
                    android:text="Mandarina"
                    android:textColor="#000"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPrice2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$3.500 COP"
                    android:textColor="#1BB200"
                    android:textSize="16sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnAdd2"
                style="@style/Widget.VitaVerde.GradientButton.CardView"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="@string/btn_add_cardview" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- CARDVIEW (ya con su contenido correcto adentro) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/productCard3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@+id/productCard2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/linearLayout3"
            style="@style/Widget.cardview.general"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:id="@+id/imgProduct3"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:padding="5dp"
                android:scaleType="centerCrop"
                android:src="@drawable/img_mandarina" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">

                <TextView
                    android:id="@+id/txtName3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/yeon_sung"
                    android:text="Mandarina"
                    android:textColor="#000"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPrice3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$3.500 COP"
                    android:textColor="#1BB200"
                    android:textSize="16sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnAdd3"
                style="@style/Widget.VitaVerde.GradientButton.CardView"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="@string/btn_add_cardview" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
